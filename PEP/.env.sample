# Server Port
PORT=___

# Auth0 Basic Config
# Note: Do NOT include https:// here. Example: chris-dev.us.auth0.com
AUTH0_DOMAIN=___
AUTH0_CLIENT_ID=___
AUTH0_CLIENT_SECRET=___

# Auth0 API / Audience
# Must match the API Identifier you created in Auth0
AUTH0_AUDIENCE=___

# Cerbos Connection
CERBOS_HOST=___

# Session Secret (The one you asked about)
# This is used to encrypt the browser session cookie.
# You can generate a random string or just use a long one like the one below:
APP_SECRET=a_very_long_random_string_over_32_chars_1234567890